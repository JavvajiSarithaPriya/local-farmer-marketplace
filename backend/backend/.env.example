# Database Connection Configuration
# Specify individual connection parameters:
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Or specify a full JDBC URL (useful for cloud database providers):
SPRING_DATASOURCE_URL=

# Port Configuration (typically provided by cloud platforms like Render or Railway)
PORT=

# CORS Allowed Origins (comma-separated list of origins)
# Example: http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=

# Application Security Token Secret
APP_TOKEN_SECRET=
